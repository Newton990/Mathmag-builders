# ─── MFA ──────────────────────────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=e60a80eecfe61963625f8de0402bcc56ad6513dcd1b4fb68cefeb9e759d487f2

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
