# ─── Argon2 ───────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── pg-boss ──────────────────────────────────────────────────────────────────
PGBOSS_SCHEMA=pgboss

# ─── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=52428800
SIGNED_URL_TTL_SECONDS=300

# ─── Account security ─────────────────────────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

TZ=Africa/Nairobi
