# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=mbms
POSTGRES_PASSWORD=mbmsdevpassword123
POSTGRES_DB=mbms_dev
DATABASE_URL="postgresql://mbms:mbmsdevpassword123@localhost:5432/mbms_dev"

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=mbms-private

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=8bf8646a77b13dc2ab291a78e1b417da286014f5b37c7f4f8ba4d3d9145a1fc69d7cdcbc3bd3076f7dd10600eb4271ebfd4626b9dfdd847940b7411e77395619
JWT_ACCESS_EXPIRY_SECONDS=900
