# ============================================================================
# Mathmag MBMS — environment variables
# Copy this file to .env (never commit .env to version control)
# ============================================================================

# ---------------------------------------------------------------------------
# Backend (apps/api — Node.js / Express)
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://mbms:mbms@localhost:5432/mbms

# JWT secrets — minimum 64 characters each (required)
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-secret-do-not-use-this-value-in-prod
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-secret-distinct-from-access

# JWT expiry (optional, sensible defaults shown)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server port (optional, default 3001)
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Object storage — MinIO (local dev) or any S3-compatible endpoint
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mbms-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=af-south-1

# ---------------------------------------------------------------------------
# Frontend (apps/web — Vite / React)
# All VITE_* vars are inlined at build time and visible in the browser bundle.
# Never put secrets here.
# ---------------------------------------------------------------------------

# Set to 'false' in production to disable demo/offline mode entirely.
# When unset (or 'true') the app auto-activates demo mode so it works
# without a live backend — useful for development and stakeholder demos.
VITE_DEMO_MODE=true

# API base URL used by the Vite dev-server proxy (optional, default /api)
# VITE_API_BASE=/api

# ---------------------------------------------------------------------------
# Email (optional — stub used when absent)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@mathmag.co.ke
# SMTP_PASS=change-me

# ---------------------------------------------------------------------------
# WhatsApp / Twilio (optional — stub used when absent)
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=change-me
# TWILIO_WHATSAPP_FROM=whatsapp:+254700000000
