# Environment variables for MBMS — local development
# Copy to .env and fill in real values. NEVER commit .env to source control.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=mbms
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=mbms_dev
DATABASE_URL="postgresql://mbms:your-postgres-password-here@localhost:5432/mbms_dev"

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password-here
MINIO_BUCKET=mbms-private

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# One secret for HS256 — used for both access tokens and step-up tokens.
JWT_SECRET=your-jwt-secret-here-min-64-chars
# Access token lifetime in seconds (default 15 min)
JWT_ACCESS_EXPIRY_SECONDS=900
# Step-up token lifetime in seconds (default 5 min)
JWT_STEP_UP_EXPIRY_SECONDS=300
# Refresh token lifetime in days (default 7)
JWT_REFRESH_EXPIRY_DAYS=7

# ─── MFA ──────────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting TOTP secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
MFA_ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── Argon2 (password hashing) ────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── pg-boss (background jobs) ────────────────────────────────────────────────
PGBOSS_SCHEMA=pgboss

# ─── File uploads ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=52428800
SIGNED_URL_TTL_SECONDS=300

# ─── Account lockout ──────────────────────────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ─── Time zone (server always uses Africa/Nairobi internally) ─────────────────
TZ=Africa/Nairobi
