# ============================================================================
# Mathmag MBMS — environment variables
# Copy this file to .env for local development or set the same values in Render/
# your hosting platform's environment settings.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend (apps/api — Node.js Fetch API)
# ---------------------------------------------------------------------------

# Explicit PostgreSQL connection string (optional). If unset, config.ts
# assembles this URL with TLS from Wasmer managed DB_* variables.
# DATABASE_URL=postgresql://mbms:mbms@localhost:5432/mbms

# Wasmer-managed PostgreSQL fallback variables (normally injected automatically)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mbms
DB_USERNAME=mbms
DB_PASSWORD=mbms

# Required production secrets
JWT_SECRET=replace-with-at-least-64-random-characters
MFA_ENCRYPTION_KEY=replace-with-exactly-64-hexadecimal-characters

# Optional runtime settings
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# JWT configuration (optional, defaults defined in code)
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_STEP_UP_EXPIRY_SECONDS=300
JWT_REFRESH_EXPIRY_DAYS=7

# Storage configuration (S3-compatible object storage)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minio123
STORAGE_BUCKET=mbms-private

# ---------------------------------------------------------------------------
# Frontend (apps/web — Vite / React)
# VITE_* variables are embedded at build time and must not contain secrets.
# ---------------------------------------------------------------------------

# Disable demo mode in production so users must sign in with real credentials.
VITE_DEMO_MODE=false

# The browser uses the same-origin API path in development (through Vite's
# proxy) and in unified Wasmer deployments.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@mathmag.co.ke
# SMTP_PASS=change-me
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=change-me
# TWILIO_WHATSAPP_FROM=whatsapp:+254700000000
