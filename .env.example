# Environment variables for MBMS — local development
# Copy to .env and fill in real values. NEVER commit .env to source control.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=mbms
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=mbms_dev
DATABASE_URL="postgresql://mbms:your-postgres-password-here@localhost:5432/mbms_dev"

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password-here
MINIO_BUCKET=mbms-private

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-here-min-64-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-min-64-chars
# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (default 7 days)
JWT_REFRESH_TTL=604800

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── Argon2 (password hashing) ────────────────────────────────────────────────
# Leave blank to use library defaults (recommended for production)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ─── pg-boss (background jobs) ────────────────────────────────────────────────
# Schema for pg-boss tables (default: pgboss)
PGBOSS_SCHEMA=pgboss

# ─── File uploads ─────────────────────────────────────────────────────────────
# Max upload size in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
# Signed URL expiry in seconds (default: 5 minutes)
SIGNED_URL_TTL_SECONDS=300

# ─── Account security ─────────────────────────────────────────────────────────
# Failed login attempts before lockout
LOGIN_MAX_ATTEMPTS=5
# Lockout duration in minutes
LOGIN_LOCKOUT_MINUTES=15

# ─── Time zone (informational — server always uses Africa/Nairobi) ────────────
TZ=Africa/Nairobi
