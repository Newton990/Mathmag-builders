{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build --workspace=packages/shared && npm run build --workspace=@mbms/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://mathmag-api.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
