load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node server.js",
    },
    node_package_manager = "npm",
    node_server = "node",
    node_build_command = "node -e \"console.log('Prebuilt')\"",
    node_version = "24",
)

build = node_build(config)

node_serve(config, build, name = "mbms")
