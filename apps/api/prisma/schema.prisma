// ─────────────────────────────────────────────────────────────────────────────
// MBMS Prisma Schema — Module 1 (Site Visit)
// Step 2: Full entity schema with all business rules encoded in constraints.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — All state machines live here. Never use ad-hoc strings.
// ═══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  CLIENT_RELATIONS_OFFICER
  VISITING_OFFICER
  LEAD_ARCHITECT
  JUNIOR_ARCHITECT
  CLIENT
  ADMIN_MANAGEMENT
  GENERAL_MANAGER
  DEPARTMENT_HEAD
  PROJECT_MANAGER
  SITE_SUPERVISOR
  STOREKEEPER
  INDEPENDENT_AUDITOR
  QUALIFIED_PROFESSIONAL
  SUBCONTRACTOR
  SUPPLIER
}

enum ConversationStatus {
  OPEN
  IN_DISCUSSION
  VISIT_AGREED
  LINKED_TO_PROJECT
  CLOSED
}

enum SourceChannel {
  MANUAL
  WALK_IN
  PHONE
  WHATSAPP
  FACEBOOK
  EMAIL
}

enum BookingStatus {
  BOOKED
  RESCHEDULED
  CANCELLED
  VISIT_UNDERWAY
  VISIT_COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

enum SurveyStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  CORRECTIONS_REQUESTED
  RESUBMITTED
}

enum MediaKind {
  PHOTO
  VIDEO
  SKETCH
  DOCUMENT
}

enum ReportGeneratorStatus {
  PENDING
  GENERATING
  GENERATED
  FAILED
}

enum ReportApprovalState {
  DRAFT
  IN_REVIEW
  APPROVED
  RETURNED
}

enum ReviewDecision {
  APPROVED
  RETURNED
}

enum ProjectStage {
  VISIT_BOOKED
  VISIT_UNDERWAY
  VISIT_COMPLETED
  REPORT_GENERATING
  REPORT_GENERATED
  UNDER_REVIEW
  CORRECTIONS_REQUESTED
  APPROVED
  PUBLISHED_TO_CLIENT
  STAGE_1_COMPLETE
}

enum NotificationEvent {
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  VISIT_REMINDER
  SURVEY_SUBMITTED
  CORRECTIONS_REQUESTED
  REPORT_APPROVED
  JUNIOR_ASSIGNED
  REPORT_PUBLISHED
  PUBLICATION_REVOKED
  ADMIN_OVERRIDE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  READ
}

enum DelegationScope {
  PROJECT
  DEPARTMENT
  COMPANY
  CASE
}

// Module 2 enums
enum DesignDiscipline {
  ARCHITECTURAL_2D
  ARCHITECTURAL_3D
  STRUCTURAL
  MECHANICAL_PLUMBING
  ELECTRICAL
  QUANTITY_SURVEYING
}

enum DesignTaskStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  RETURNED_WITH_COMMENTS
  TECHNICALLY_APPROVED
  RELEASED
  SUPERSEDED
}

enum WorkingFileKind {
  NATIVE_CAD
  PDF
  IMAGE
  CALCULATION
  SCHEDULE
  OTHER
}

enum DesignApprovalType {
  TWO_D
  THREE_D
}

enum DesignApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CoordinationIssueStatus {
  OPEN
  ASSIGNED
  IN_RESOLUTION
  RESOLVED
  CLOSED
}

enum DesignChangeType {
  MINOR
  MAJOR
}

enum EstimateStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

// Module 3 enums
enum ProposalStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AcceptanceMethod {
  PORTAL
  SIGNED_FORM
  MEETING
}

enum AcceptanceStatus {
  PENDING
  VERIFIED
  RETURNED_FOR_CLARIFICATION
  REJECTED
  ACCEPTED
}

enum PaymentMilestoneStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum ModuleReleaseStatus {
  PENDING
  RELEASED
  BLOCKED
}

// Module 4 enums
enum ApprovalCaseStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  RETURNED
  CLEARED
  REJECTED
}

enum PermitStatus {
  PENDING
  APPLIED
  ISSUED
  EXPIRED
  SUSPENDED
  REJECTED
}

enum PrintingStatus {
  PENDING
  PRINTED
  STAMPED
  ISSUED
}

// Module 5 enums
enum ContractStatus {
  DRAFT
  SENT
  UNDER_NEGOTIATION
  EXECUTED
  TERMINATED
  EXPIRED
}

enum ServiceEngagementType {
  DESIGN_ONLY
  PRINTING_ONLY
  APPROVALS_ONLY
  TECHNICAL_INSPECTION
  LABOUR_ONLY
  FULL_CONSTRUCTION
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ═══════════════════════════════════════════════════════════════════════════════
// SEQUENCE — Safe project reference generator (MB-2026-001)
// Uses a row-locked counter per year; never gaps on rollback.
// ═══════════════════════════════════════════════════════════════════════════════

model ProjectSequence {
  id      Int    @id @default(autoincrement())
  year    Int
  prefix  String @default("MB")
  counter Int    @default(0)

  @@unique([year, prefix])
  @@map("project_sequences")
}

// ═══════════════════════════════════════════════════════════════════════════════
// USERS
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations — kept for referential integrity; history never deleted
  assignedConversations Conversation[]      @relation("ConversationAssignee")
  messages              Message[]
  bookedVisits          VisitBooking[]      @relation("BookedByUser")
  assignedVisitBookings VisitBooking[]      @relation("AssignedOfficerUser")
  capturedSurveys       SiteSurvey[]
  approvedReports       ReportVersion[]     @relation("ApprovedByUser")
  reviews               Review[]
  juniorAssignments     JuniorAssignment[]  @relation("JuniorArchitectUser")
  madeAssignments       JuniorAssignment[]  @relation("AssignedByUser")
  publications          PortalPublication[] @relation("PublishedByUser")
  revokedPublications   PortalPublication[] @relation("RevokedByUser")
  auditEvents           AuditEvent[]        @relation("AuditActor")
  notifications         Notification[]
  refreshTokens         RefreshToken[]
  mfa                   UserMfa?
  roleGrants            Json?
  delegationMandatesAsGrantee Json?
  delegationMandatesAsGrantor Json?
  actingAuthoritiesAsActing   Json?
  actingAuthoritiesAsPrincipal Json?
  mandateActions        Json?
  exceptionsRaised      Json?
  exceptionsDecided     Json?
  protectedAuditCases   Json?

  // Module 2 relations
  designTasksAssigned   DesignTask[]          @relation("DesignTaskAssignee")
  designTasksCreated    DesignTask[]          @relation("DesignTaskCreator")
  designTasksReviewed   DesignTaskReview[]    @relation("DesignTaskReviewer")
  designApprovals       DesignApproval[]      @relation("DesignApprover")
  coordinationIssuesRaised CoordinationIssue[] @relation("CoordinationIssueRaiser")
  coordinationIssuesOwned   CoordinationIssue[] @relation("CoordinationIssueOwner")
  workingFilesUploaded     WorkingFileVersion[] @relation("WorkingFileUploader")
  estimatesCreated         CostEstimate[]       @relation("CostEstimateCreator")
  estimatesApproved        CostEstimate[]       @relation("CostEstimateApprover")
  designChangesRequested   DesignChange[]       @relation("DesignChangeRequester")
  designChangesDecided     DesignChange[]       @relation("DesignChangeDecider")

  @@index([role, isActive])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONTACTS — Real people / organisations who enquire
// ═══════════════════════════════════════════════════════════════════════════════

model Contact {
  id               String        @id @default(uuid())
  fullName         String
  organisation     String?
  primaryPhone     String        // Normalised +254 format; validated before insert
  alternatePhone   String?
  email            String?
  consentMarketing Boolean       @default(false)
  consentDataProc  Boolean       @default(true)
  sourceChannel    SourceChannel @default(MANUAL)
  externalId       String?       // Platform ID for channel adapters
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  conversations Conversation[]
  projects      Project[]

  @@index([primaryPhone])
  @@index([email])
  @@index([externalId, sourceChannel])
  @@map("contacts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONVERSATIONS (inbox threads) + MESSAGES
// ═══════════════════════════════════════════════════════════════════════════════

model Conversation {
  id               String             @id @default(uuid())
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedStaffId  String?
  assignedStaff    User?              @relation("ConversationAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  channel          SourceChannel      @default(MANUAL)
  externalThreadId String?            // Dedup key for external platforms
  status           ConversationStatus @default(OPEN)
  subject          String?
  followUpAt       DateTime?
  lastActivityAt   DateTime           @default(now())
  // Set when conversation is confirmed into a project booking
  linkedProjectId  String?
  linkedProject    Project?           @relation("ConversationProject", fields: [linkedProjectId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  messages Message[]

  // Prevents the same external thread from being imported twice
  @@unique([externalThreadId, channel])
  @@index([contactId])
  @@index([assignedStaffId])
  @@index([status, lastActivityAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  authorId       String?      // null for system / automated messages
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content        String
  isNote         Boolean      @default(false) // true = internal staff note, not sent to client
  externalMsgId  String?      // Message ID in external platform (dedup)
  sentAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ─── Channel adapter webhook events (dedup + replay safety) ──────────────────

model WebhookEvent {
  id          String        @id @default(uuid())
  channel     SourceChannel
  externalId  String        // Unique event ID from the platform
  payload     Json
  processed   Boolean       @default(false)
  processedAt DateTime?
  error       String?
  receivedAt  DateTime      @default(now())

  @@unique([channel, externalId]) // Idempotency: never process the same event twice
  @@index([processed, receivedAt])
  @@map("webhook_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PROJECTS
// Business rule: ONE project per booking (enforced by VisitBooking.projectId @unique)
// Business rule: enquiry != project — never create until booking confirmed
// ═══════════════════════════════════════════════════════════════════════════════

model Project {
  id                        String       @id @default(uuid())
  reference                 String       @unique // e.g. MB-2026-001
  contactId                 String
  contact                   Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  projectType               String?
  siteCounty                String
  siteSubCounty             String?
  siteArea                  String
  siteDirections            String?
  siteDescription           String?
  currentStage              ProjectStage @default(VISIT_BOOKED)
  createdFromConversationId String?      // Nullable: walk-ins/phone calls have no thread
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  visitBooking      VisitBooking?
  conversations     Conversation[]      @relation("ConversationProject")
  juniorAssignments JuniorAssignment[]
  auditEvents       AuditEvent[]        @relation("ProjectAuditEvents")

  // Module 2 relations
  designPackages        DesignPackage[]
  designTasks           DesignTask[]
  designApprovals       DesignApproval[]
  coordinationIssues    CoordinationIssue[]
  workingFileVersions   WorkingFileVersion[]
  costEstimates         CostEstimate[]
  designChanges         DesignChange[]
  // Module 3 relations
  proposals             ProposalSnapshot[]
  clientPayments        ClientPayment[]
  moduleReleases        ModuleRelease[]
  approvalCases         ApprovalCase[]
  contracts             Contract[]
  serviceEngagements    ServiceEngagement[]

  @@index([contactId])
  @@index([currentStage])
  @@map("projects")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VISIT BOOKINGS
// Business rule: @unique on projectId enforces one-booking-one-project at DB level.
// Business rule: idempotencyKey prevents duplicate creation on network retry.
// ═══════════════════════════════════════════════════════════════════════════════

model VisitBooking {
  id                  String        @id @default(uuid())
  projectId           String        @unique // ← DB-enforced: one booking per project
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  scheduledAt         DateTime      // UTC; display in Africa/Nairobi
  assignedOfficerId   String?
  assignedOfficer     User?         @relation("AssignedOfficerUser", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  visitFeeKes         Decimal?      @db.Decimal(12, 2)
  paymentStatus       PaymentStatus @default(PENDING)
  status              BookingStatus @default(BOOKED)
  specialInstructions String?
  idempotencyKey      String        @unique // Client-generated; prevents double-booking on retry
  bookedById          String
  bookedBy            User          @relation("BookedByUser", fields: [bookedById], references: [id], onDelete: Restrict)
  bookedAt            DateTime      @default(now())
  checkInAt           DateTime?
  checkInGps          Json?         // { latitude, longitude, accuracy, capturedAt, note? }
  checkOutAt          DateTime?
  checkOutGps         Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  history  BookingHistory[]
  surveys  SiteSurvey[]

  @@index([assignedOfficerId, status])
  @@index([status, scheduledAt])
  @@map("visit_bookings")
}

// Append-only history — never deleted, never updated
model BookingHistory {
  id             String        @id @default(uuid())
  bookingId      String
  booking        VisitBooking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  oldScheduledAt DateTime?
  newScheduledAt DateTime?
  oldStatus      BookingStatus
  newStatus      BookingStatus
  reason         String        // Required for all changes
  changedById    String        // User ID (not a FK to allow staff deactivation)
  createdAt      DateTime      @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_history")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SITE SURVEYS (sections A–G)
// Sections stored as versioned JSON; schemaVersion tracks breaking changes.
// lockedAt = non-null means submitted/immutable; new versions start fresh.
// ═══════════════════════════════════════════════════════════════════════════════

model SiteSurvey {
  id                String       @id @default(uuid())
  bookingId         String
  booking           VisitBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  capturedById      String
  capturedBy        User         @relation(fields: [capturedById], references: [id], onDelete: Restrict)
  version           Int          @default(1)
  status            SurveyStatus @default(NOT_STARTED)
  schemaVersion     String       @default("1.0")
  previousVersionId String?      // Links resubmissions to their predecessor

  // Section A: Project & client details (auto-populated snapshot)
  sectionA Json? // { projectRef, clientName, siteCounty, siteArea, bookedAt, officerName }

  // Section B: Plot configuration & access
  // shape: "rectangular"|"corner"|"irregular"|"other"
  // dimensions: [{ side, lengthM, lengthFt }]
  // frontageM, accessRoad, adjacentDevelopments, existingStructures, trees, obstacles
  // surveyDocKey (uploaded survey document), gpsPin { lat, lng, shareUrl }
  sectionB Json?

  // Section C: Orientation, sun, wind, terrain
  // compassNorthDeg (manual adjustment), sunPath (COMPUTED via suncalc — labelled "computed/informational")
  // windDirection (OBSERVED — labelled "observed"), topography, groundNotes, drainageNotes, waterFlow
  // All ground/drainage notes labelled "preliminary"
  sectionC Json?

  // Section D: Photo/video register — IDs of SurveyMedia records
  sectionD Json? // { mediaIds: string[] }

  // Section E: Sketch
  // sketchVersionId (canvas) OR uploadedKey (photo/PDF of hand sketch)
  // Always includes label: "Preliminary field sketch - not a cadastral survey"
  sectionE Json?

  // Section F: Client design brief
  // description, voiceNoteKey?, buildingType, storeys, rooms [{ type, qty }]
  // preferences, referencePhotoIds, specialNeeds, budgetRangeKes?, timeline?
  // officerRecommendations (SEPARATE box — kept internal, never shown to client directly)
  sectionF Json?

  // Section G: Pre-submission review checklist
  // completionChecklist: [{ item, status: "complete"|"not_available", reason? }]
  // officerNotes
  sectionG Json?

  checkInAt         DateTime?
  checkInGps        Json?
  checkOutAt        DateTime?
  checkOutGps       Json?
  lockedAt          DateTime?  // Non-null = immutable (submitted)
  submittedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  media    SurveyMedia[]
  sketches SketchVersion[]
  reports  ReportVersion[]

  @@unique([bookingId, version])
  @@index([bookingId, status])
  @@index([capturedById])
  @@map("site_surveys")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SURVEY MEDIA
// Originals stored in private bucket only — never public URLs.
// idempotencyKey prevents duplicate uploads on retry.
// ═══════════════════════════════════════════════════════════════════════════════

model SurveyMedia {
  id              String     @id @default(uuid())
  surveyId        String
  survey          SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  kind            MediaKind
  category        String     // e.g. "plot-boundary", "existing-structure", "road-frontage"
  caption         String?
  storageKey      String     // Original in private bucket
  previewKey      String?    // Compressed preview in private bucket
  checksum        String     // SHA-256 of original (verified on upload)
  mimeType        String
  sizeBytes       BigInt
  capturedAt      DateTime?
  idempotencyKey  String     @unique // Prevents duplicate file records on retry
  uploadedAt      DateTime   @default(now())

  permittedPublications PortalPublication[] @relation("PermittedMedia")

  @@index([surveyId, kind])
  @@index([surveyId, category])
  @@map("survey_media")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SKETCH VERSIONS
// strokesJson preserved for full edit history.
// Label is enforced: "Preliminary field sketch - not a cadastral survey".
// ═══════════════════════════════════════════════════════════════════════════════

model SketchVersion {
  id          String     @id @default(uuid())
  surveyId    String
  survey      SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  strokesJson Json       // Array of stroke primitives (draw, erase, label, etc.)
  renderedKey String?    // PNG snapshot in private storage
  version     Int        @default(1)
  // Always stored; never omitted
  label       String     @default("Preliminary field sketch - not a cadastral survey")
  editedAt    DateTime   @default(now())
  editedById  String     // User ID

  @@unique([surveyId, version])
  @@index([surveyId])
  @@map("sketch_versions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// REPORT VERSIONS
// Immutability: once APPROVED, the row must not be changed.
// A revision creates a NEW row with versionNumber + 1.
// ═══════════════════════════════════════════════════════════════════════════════

model ReportVersion {
  id              String                @id @default(uuid())
  surveyId        String
  survey          SiteSurvey            @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  versionNumber   Int
  docxKey         String?               // DOCX in private bucket
  pdfKey          String?               // PDF in private bucket
  generatorStatus ReportGeneratorStatus @default(PENDING)
  generatorError  String?
  approvalState   ReportApprovalState   @default(DRAFT)
  approvedById    String?
  approvedBy      User?                 @relation("ApprovedByUser", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  generatedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  reviews           Review[]
  publications      PortalPublication[]
  juniorAssignments JuniorAssignment[]

  @@unique([surveyId, versionNumber])
  @@index([surveyId, approvalState])
  @@map("report_versions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// REVIEWS
// One review per decision event. Append-only (only inserts).
// ═══════════════════════════════════════════════════════════════════════════════

model Review {
  id              String         @id @default(uuid())
  reportVersionId String
  reportVersion   ReportVersion  @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  reviewerId      String
  reviewer        User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision        ReviewDecision
  comments        String         // Required for RETURNED; optional for APPROVED
  createdAt       DateTime       @default(now())

  @@index([reportVersionId, createdAt])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════════════════════
// JUNIOR ARCHITECT ASSIGNMENTS
// Separate from approval (business rule 4).
// References the specific approved report version.
// ═══════════════════════════════════════════════════════════════════════════════

model JuniorAssignment {
  id                String        @id @default(uuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reportVersionId   String
  reportVersion     ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  juniorArchitectId String
  juniorArchitect   User          @relation("JuniorArchitectUser", fields: [juniorArchitectId], references: [id], onDelete: Restrict)
  assignedById      String
  assignedBy        User          @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Restrict)
  dueDate           DateTime?
  priority          Priority      @default(NORMAL)
  instructions      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([projectId])
  @@index([juniorArchitectId])
  @@map("junior_assignments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PORTAL PUBLICATIONS
// Publication is SEPARATE from approval (business rule 4).
// Only APPROVED report versions can be published.
// Clients receive ONLY the explicitly selected media.
// supersededById chains: old → new when a publication is replaced.
// ═══════════════════════════════════════════════════════════════════════════════

model PortalPublication {
  id              String        @id @default(uuid())
  reportVersionId String
  reportVersion   ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  publishedById   String
  publishedBy     User          @relation("PublishedByUser", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt     DateTime      @default(now())
  revokedAt       DateTime?
  revokedById     String?
  revokedBy       User?         @relation("RevokedByUser", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason    String?
  // Self-relation: tracks which publication replaced this one
  supersededById  String?
  supersededBy    PortalPublication?  @relation("PublicationChain", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      PortalPublication[] @relation("PublicationChain")

  permittedMedia SurveyMedia[] @relation("PermittedMedia")

  @@index([reportVersionId])
  @@index([revokedAt])
  @@map("portal_publications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// Events stored even if external delivery fails (decouple storage from delivery).
// Delivery layer is pluggable (email/WhatsApp adapters added later).
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id             String              @id @default(uuid())
  recipientId    String
  recipient      User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  event          NotificationEvent
  entityType     String              // "Project" | "VisitBooking" | "ReportVersion" | ...
  entityId       String
  title          String
  body           String
  channel        NotificationChannel @default(IN_APP)
  deliveryStatus DeliveryStatus      @default(PENDING)
  deliveryError  String?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([deliveryStatus, createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// REFRESH TOKENS — Opaque rotation tokens. One active per session.
// Revoked on logout, logout-all, rotation (reuse detection), or account lock.
// ═══════════════════════════════════════════════════════════════════════════════

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique  // Opaque 96-char hex string
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime
  revokedAt   DateTime?
  revokeReason String?  // LOGOUT | LOGOUT_ALL | ROTATED | REUSE_DETECTED | ADMIN
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// USER MFA — TOTP configuration per user. One row per user.
// Secret is AES-256-GCM encrypted at rest. Backup codes are SHA-256 hashed.
// enabled=false means setup initiated but not yet confirmed.
// ═══════════════════════════════════════════════════════════════════════════════

model UserMfa {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret  String    // AES-256-GCM: iv:tag:ciphertext (all hex)
  backupCodeHashes String[]  // SHA-256 of each code; consumed on use
  enabled          Boolean   @default(false)
  enabledAt        DateTime?
  disabledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("user_mfa")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUDIT EVENTS — Append-only. Never updated, never deleted.
// A PostgreSQL trigger (in migration SQL) enforces immutability at DB level.
// Every critical action MUST write one of these before returning 200.
// ═══════════════════════════════════════════════════════════════════════════════

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?  // null for system-generated events
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "BOOKING_CONFIRMED", "REPORT_APPROVED", "PUBLICATION_REVOKED"
  entityType String   // e.g. "Project", "VisitBooking", "ReportVersion"
  entityId   String
  projectId  String?  // Denormalised for fast project-scoped audit queries
  project    Project? @relation("ProjectAuditEvents", fields: [projectId], references: [id], onDelete: SetNull)
  before     Json?    // Previous state (null for create events)
  after      Json?    // New state (null for delete events)
  reason     String?  // Required for admin overrides and returns
  ipAddress  String?
  userAgent  String?
  // V3 Foundation audit envelope
  mandateId  String?
  representedRole String?
  authorizingMandateId String?
  actionTimestamp DateTime @default(now())
  previousState Json?
  nextState Json?
  reasonCode String?
  attachments Json?
  correlationId String?
  sourceRevisions Json?
  createdAt  DateTime @default(now())

  // No updatedAt — this table is append-only
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([correlationId])
  @@index([mandateId])
  @@map("audit_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 2 — Planning & Technical Design
// ═══════════════════════════════════════════════════════════════════════════════

model DesignPackage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  discipline DesignDiscipline
  isReleased Boolean @default(false)
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designTasks         DesignTask[]
  workingFileVersions WorkingFileVersion[]
  coordinationIssues  CoordinationIssue[]
  designApprovals     DesignApproval[]

  @@unique([projectId, discipline])
  @@index([projectId])
  @@map("design_packages")
}

model DesignTask {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  designPackageId String?
  designPackage   DesignPackage?  @relation(fields: [designPackageId], references: [id], onDelete: SetNull)
  discipline      DesignDiscipline
  title           String
  description     String?
  assigneeId      String?
  assignee        User?           @relation("DesignTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User            @relation("DesignTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status          DesignTaskStatus @default(DRAFT)
  plannedDeadline DateTime?
  submittedAt     DateTime?
  approvedAt      DateTime?
  releasedAt      DateTime?
  supersededAt    DateTime?
  parentTaskId    String?
  parentTask      DesignTask?      @relation("DesignTaskChain", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks      DesignTask[]     @relation("DesignTaskChain")
  instructions    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  submissions     WorkingFileVersion[]
  reviews         DesignTaskReview[]
  coordinationIssues CoordinationIssue[]

  @@index([projectId, discipline])
  @@index([assigneeId, status])
  @@index([status])
  @@map("design_tasks")
}

model DesignTaskReview {
  id          String     @id @default(uuid())
  taskId      String
  task        DesignTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  reviewerId  String
  reviewer    User       @relation("DesignTaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision    ReviewDecision
  comments    String
  corrections Json?
  createdAt   DateTime   @default(now())

  @@index([taskId, createdAt])
  @@map("design_task_reviews")
}

model WorkingFileVersion {
  id              String           @id @default(uuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  designPackageId String?
  designPackage   DesignPackage?   @relation(fields: [designPackageId], references: [id], onDelete: SetNull)
  taskId          String?
  task            DesignTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  kind            WorkingFileKind  @default(PDF)
  fileName        String
  storageKey      String
  previewKey      String?
  checksum        String
  mimeType        String
  sizeBytes       BigInt
  versionNumber   Int              @default(1)
  isNative        Boolean          @default(false)
  isClientVisible Boolean          @default(false)
  label           String?
  uploadedById    String
  uploadedBy      User             @relation("WorkingFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt      DateTime         @default(now())

  @@index([projectId, designPackageId])
  @@index([taskId])
  @@map("working_file_versions")
}

model DesignApproval {
  id              String              @id @default(uuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  designPackageId String?
  designPackage   DesignPackage?      @relation(fields: [designPackageId], references: [id], onDelete: SetNull)
  type            DesignApprovalType
  status          DesignApprovalStatus @default(PENDING)
  versionId       String?             // Exact version reference
  approvedById    String?
  approvedBy      User?               @relation("DesignApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  evidenceKey     String?
  evidenceNotes   String?
  clientIdentity  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId, type])
  @@index([status])
  @@map("design_approvals")
}

model CoordinationIssue {
  id              String                  @id @default(uuid())
  projectId       String
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  designPackageId String?
  designPackage   DesignPackage?          @relation(fields: [designPackageId], references: [id], onDelete: SetNull)
  taskId          String?
  task            DesignTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  raisedById      String
  raisedBy        User                    @relation("CoordinationIssueRaiser", fields: [raisedById], references: [id], onDelete: Restrict)
  ownerId         String?
  owner           User?                   @relation("CoordinationIssueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  title           String
  description     String
  severity        String                  @default("MEDIUM")
  status          CoordinationIssueStatus @default(OPEN)
  dueDate         DateTime?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  affectedItems CoordinationIssueItem[]

  @@index([projectId, status])
  @@index([ownerId, status])
  @@map("coordination_issues")
}

model CoordinationIssueItem {
  id        String             @id @default(uuid())
  issueId   String
  issue     CoordinationIssue  @relation(fields: [issueId], references: [id], onDelete: Restrict)
  discipline DesignDiscipline
  referenceId String?
  notes     String?

  @@map("coordination_issue_items")
}

model CostEstimate {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versionNumber   Int
  status          EstimateStatus @default(DRAFT)
  isSummary       Boolean       @default(true)
  currency        String        @default("KES")
  totalAmount     Decimal       @db.Decimal(14, 2)
  assumptions     String?
  exclusions      String?
  createdById     String
  createdBy       User          @relation("CostEstimateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?         @relation("CostEstimateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines CostEstimateLine[]

  @@unique([projectId, versionNumber])
  @@index([projectId, status])
  @@map("cost_estimates")
}

model CostEstimateLine {
  id          String       @id @default(uuid())
  estimateId  String
  estimate    CostEstimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  itemCode    String?
  description String
  unit        String?
  quantity    Decimal?     @db.Decimal(12, 3)
  rate        Decimal?     @db.Decimal(14, 2)
  amount      Decimal      @db.Decimal(14, 2)
  sourceVersionId String?
  notes       String?

  @@map("cost_estimate_lines")
}

model DesignChange {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changeType      DesignChangeType
  reason          String
  requestedById   String
  requestedBy     User           @relation("DesignChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById     String?
  decidedBy       User?          @relation("DesignChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decision        String?
  decisionAt      DateTime?
  feeImpact       Decimal?       @db.Decimal(12, 2)
  timeImpactDays  Int?
  requiresClientReacceptance Boolean @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@map("design_changes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 3 — Client Acceptance & Budget
// ═══════════════════════════════════════════════════════════════════════════════

model ProposalSnapshot {
  id                  String         @id @default(uuid())
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versionNumber       Int
  status              ProposalStatus @default(DRAFT)
  title               String?
  summaryContent      Json?
  inclusions          Json?
  exclusions          Json?
  manifest            Json?
  costEstimateId      String?
  publishedById       String?
  publishedAt         DateTime?
  detailedBudgetVisible Boolean      @default(false)
  snapshotHash        String?
  supersededById      String?
  supersededAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  documents       ProposalDocument[]
  reviews         ClientReview[]
  acceptances     ClientAcceptance[]
  payments        ClientPayment[]

  @@unique([projectId, versionNumber])
  @@index([projectId, status])
  @@map("proposal_snapshots")
}

model ProposalDocument {
  id          String           @id @default(uuid())
  proposalId  String
  proposal    ProposalSnapshot @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  fileName    String
  storageKey  String
  mimeType    String
  isClientVisible Boolean      @default(true)
  sortOrder   Int              @default(0)
  uploadedAt  DateTime         @default(now())

  @@index([proposalId])
  @@map("proposal_documents")
}

model ClientReview {
  id           String           @id @default(uuid())
  proposalId   String
  proposal     ProposalSnapshot @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  reviewerId   String?
  reviewerName String?
  comment      String
  response     String?
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())

  @@index([proposalId, createdAt])
  @@map("client_reviews")
}

model ClientAcceptance {
  id              String           @id @default(uuid())
  proposalId      String
  proposal        ProposalSnapshot @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  method          AcceptanceMethod
  status          AcceptanceStatus @default(PENDING)
  clientIdentity  String?
  acceptanceText  String?
  evidenceKey     String?
  evidenceNotes   String?
  signedAt        DateTime?
  verifiedById    String?
  verifiedAt      DateTime?
  verificationNotes String?
  versionHash     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([proposalId, status])
  @@map("client_acceptances")
}

model ClientPayment {
  id                  String                @id @default(uuid())
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  proposalId          String?
  proposal            ProposalSnapshot?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  amountDue           Decimal               @db.Decimal(14, 2)
  amountPaid          Decimal               @default(0) @db.Decimal(14, 2)
  currency            String                @default("KES")
  milestoneDescription String?
  status              PaymentMilestoneStatus @default(PENDING)
  transactionRef      String?               @unique
  receiptKey          String?
  verifiedById        String?
  verifiedAt          DateTime?
  notes               String?
  paidAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([projectId, status])
  @@map("client_payments")
}

model PaymentException {
  id                String    @id @default(uuid())
  projectId         String
  reason            String
  conditions        String?
  authorizedById    String
  authorizedAt      DateTime  @default(now())
  scope             String?
  withinLegalLimits Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@index([projectId])
  @@map("payment_exceptions")
}

model ModuleRelease {
  id                String             @id @default(uuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  fromModule        Int
  toModule          Int
  status            ModuleReleaseStatus @default(PENDING)
  releasedById      String?
  releasedAt        DateTime?
  gateChecklist     Json?
  notes             String?
  hasPaymentException Boolean          @default(false)
  paymentExceptionId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([projectId, toModule])
  @@map("module_releases")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 4 — Approvals
// ═══════════════════════════════════════════════════════════════════════════════

model ApprovalCase {
  id          String             @id @default(uuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  caseNumber  String             @unique
  status      ApprovalCaseStatus @default(OPEN)
  assignedToId String?
  priority    Priority           @default(NORMAL)
  openedAt    DateTime           @default(now())
  clearedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  permits ApprovalPermit[]
  prints  ApprovalPrint[]

  @@index([projectId, status])
  @@map("approval_cases")
}

model ApprovalPermit {
  id        String       @id @default(uuid())
  caseId    String
  case      ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  permitType String
  authority  String?
  status     PermitStatus @default(PENDING)
  referenceNo String?
  appliedAt  DateTime?
  issuedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("approval_permits")
}

model ApprovalPrint {
  id          String         @id @default(uuid())
  caseId      String
  case        ApprovalCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  documentName String
  versionId   String?
  status      PrintingStatus @default(PENDING)
  printedById String?
  stampedById String?
  printedAt   DateTime?
  stampedAt   DateTime?
  issuedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("approval_prints")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE 5 — Contracts
// ═══════════════════════════════════════════════════════════════════════════════

model ServiceEngagement {
  id          String                @id @default(uuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type        ServiceEngagementType
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  contracts Contract[]

  @@index([projectId])
  @@map("service_engagements")
}

model Contract {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  engagementId    String?
  engagement      ServiceEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  contractNumber  String        @unique
  status          ContractStatus @default(DRAFT)
  parties         Json?
  terms           Json?
  value           Decimal?      @db.Decimal(14, 2)
  currency        String        @default("KES")
  sentAt          DateTime?
  executedAt      DateTime?
  executedById    String?
  terminatedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId, status])
  @@map("contracts")
}
