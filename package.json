{
  "name": "mathmag-mbms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web -- --host 0.0.0.0",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web -- --host 0.0.0.0",
    "start": "node server.js",
    "build": "npm run build --workspace=@mbms/shared && npm run build --workspace=@mbms/api && npm run build --workspace=@mbms/web",
    "preview": "npm run preview --workspace=apps/web",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=packages/shared && npm run test --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
